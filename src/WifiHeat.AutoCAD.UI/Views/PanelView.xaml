<UserControl x:Class="WifiHeat.AutoCAD.UI.Views.PanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI" FontSize="12" MinWidth="280"
             Background="{DynamicResource Panel.Background}" Foreground="{DynamicResource Panel.Foreground}"
             UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/WifiHeat.AutoCAD.UI;component/Views/Themes/Dark.xaml" />
        <ResourceDictionary Source="/WifiHeat.AutoCAD.UI;component/Views/Themes/Controls.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>

  <Grid>
    <!-- Sin documento -->
    <TextBlock x:Name="NoDocument" Style="{StaticResource EmptyState}" Margin="16" TextAlignment="Center" VerticalAlignment="Center"
               Text="No hay ningún dibujo abierto. Abrir un dibujo para usar WifiHeat." />

    <Grid x:Name="Body" Visibility="Collapsed">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- Encabezado -->
      <Border Grid.Row="0" Background="{DynamicResource Header.Background}" Padding="10,6">
        <DockPanel>
          <Button DockPanel.Dock="Right" Content="Act_ualizar" Command="{Binding RefreshCommand}"
                  ToolTip="Vuelve a leer muros, AP y área del dibujo." />
          <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
            <Run Text="WifiHeat" FontWeight="Bold" FontSize="14" />
            <Run Text="  " />
            <Run Text="{Binding DocumentName, Mode=OneWay}" Foreground="{DynamicResource Panel.Muted}" />
          </TextBlock>
        </DockPanel>
      </Border>

      <ScrollViewer x:Name="Scroller" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <StackPanel x:Name="Sections" Margin="8,8,8,0">

          <!-- 1 · Preparar plano -->
          <Expander Header="1 · Preparar plano" DataContext="{Binding Prepare}">
            <StackPanel>
              <Grid Margin="0,2,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource FieldLabel}" Text="Unidad del dibujo" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding Units}" SelectedItem="{Binding SelectedUnit}" DisplayMemberPath="Label"
                          Tag="Elegir la unidad…" AutomationProperties.Name="Unidad del dibujo" />
              </Grid>
              <TextBlock Margin="0,4,0,0" Text="{Binding UnitHint}">
                <TextBlock.Style>
                  <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding HasUnit}" Value="False">
                        <Setter Property="Foreground" Value="{DynamicResource Status.Warning}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>

              <Border Style="{StaticResource Rule}" />
              <TextBlock Style="{StaticResource SubHeading}" Text="Ejes de muros dibujados con dos caras" />
              <DockPanel>
                <Button DockPanel.Dock="Left" Content="Elegir _zona de la planta…" Command="{Binding PickWindowCommand}"
                        ToolTip="Marcá con dos clics el rectángulo que encierra una sola planta." />
                <TextBox DockPanel.Dock="Right" Width="52" Text="{Binding MergeGapText}" AutomationProperties.Name="Umbral de unión en metros"
                         ToolTip="Los tramos alineados separados hasta esta distancia se unen: las aberturas más angostas se cierran." />
                <TextBlock Style="{StaticResource FieldLabel}" Text="Unir tramos hasta (m)" HorizontalAlignment="Right" TextAlignment="Right" Margin="8,0,6,0" />
              </DockPanel>
              <TextBlock Style="{StaticResource EmptyState}" Text="Marcá con dos clics el rectángulo que encierra una sola planta para ver sus capas."
                         Visibility="{Binding HasWindow, Converter={StaticResource Hidden}}" />
              <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,2" Text="{Binding WindowText}"
                         Visibility="{Binding HasWindow, Converter={StaticResource Visible}}" />
              <ItemsControl ItemsSource="{Binding Layers}" Focusable="False">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <DockPanel Margin="0,3,0,0">
                      <TextBlock DockPanel.Dock="Right" Style="{StaticResource Muted}" Text="{Binding CountText}" Margin="8,0,0,0" VerticalAlignment="Center" />
                      <CheckBox IsChecked="{Binding IsSelected}" AutomationProperties.Name="{Binding Name}">
                        <TextBlock TextTrimming="CharacterEllipsis">
                          <Run Text="{Binding Name, Mode=OneWay}" />
                          <Run Text="{Binding NoteSuffix, Mode=OneWay}" Foreground="{DynamicResource Panel.Muted}" FontStyle="Italic" />
                        </TextBlock>
                      </CheckBox>
                    </DockPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Button Style="{StaticResource Primary}" Margin="0,8,0,0" Content="_Generar ejes" Command="{Binding GenerateAxesCommand}"
                      IsEnabled="{Binding CanGenerate}" ToolTip="Crea los ejes en la capa WIFIHEAT_MUROS. Repetirlo sobre la misma zona no los duplica." />
              <TextBlock Style="{StaticResource Value}" Margin="0,6,0,0" Text="{Binding AxisSummary}"
                         Visibility="{Binding HasAxisSummary, Converter={StaticResource Visible}}" />
              <Button Style="{StaticResource LinkButton}" Margin="0,4,0,0" Content="{Binding UnpairedText}" Command="{Binding ShowUnpairedCommand}"
                      Visibility="{Binding HasUnpaired, Converter={StaticResource Visible}}" />
            </StackPanel>
          </Expander>

          <!-- 2 · Plano y validación -->
          <Expander Header="2 · Plano y validación" DataContext="{Binding Validation}" Tag="{Binding Summary}">
            <StackPanel>
              <DockPanel Margin="0,2,0,0">
                <Button DockPanel.Dock="Left" Content="_Validar" Command="{Binding ValidateCommand}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                  <TextBlock Margin="10,0,0,0" FontWeight="SemiBold" Text="{Binding WallsText}" />
                  <TextBlock Margin="10,0,0,0" FontWeight="SemiBold" Text="{Binding ErrorsText}">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource Status.Error}" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding ErrorCount}" Value="0">
                            <Setter Property="Foreground" Value="{DynamicResource Panel.Muted}" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                  <TextBlock Margin="10,0,0,0" FontWeight="SemiBold" Text="{Binding WarningsText}">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource Status.Warning}" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding WarningCount}" Value="0">
                            <Setter Property="Foreground" Value="{DynamicResource Panel.Muted}" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                </StackPanel>
              </DockPanel>
              <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Status.Success}" Text="{Binding EmptyText}"
                         Visibility="{Binding HasItems, Converter={StaticResource Hidden}}" />
              <ListBox Margin="0,8,0,0" MaxHeight="170" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}"
                       Visibility="{Binding HasItems, Converter={StaticResource Visible}}"
                       Background="{DynamicResource Inset.Background}" BorderBrush="{DynamicResource Card.Border}" BorderThickness="1"
                       ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Problemas del plano">
                <ListBox.ItemContainerStyle>
                  <Style TargetType="ListBoxItem">
                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                    <Setter Property="Foreground" Value="{DynamicResource Panel.Foreground}" />
                    <Setter Property="Template">
                      <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                          <Border x:Name="Chrome" Background="Transparent" Padding="6,4" BorderThickness="2,0,0,0" BorderBrush="Transparent">
                            <ContentPresenter />
                          </Border>
                          <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                              <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Row.Hover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                              <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Row.Selected}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                              <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Accent.Hover}" />
                            </Trigger>
                          </ControlTemplate.Triggers>
                        </ControlTemplate>
                      </Setter.Value>
                    </Setter>
                  </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <StackPanel>
                      <TextBlock TextWrapping="Wrap">
                        <Run Text="{Binding SeverityLabel, Mode=OneWay}" FontWeight="Bold">
                          <Run.Style>
                            <Style TargetType="Run">
                              <Setter Property="Foreground" Value="{DynamicResource Status.Warning}" />
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding IsError}" Value="True">
                                  <Setter Property="Foreground" Value="{DynamicResource Status.Error}" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </Run.Style>
                        </Run>
                        <Run Text=" · " />
                        <Run Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold" />
                      </TextBlock>
                      <TextBlock Style="{StaticResource Muted}" Text="{Binding Message}" />
                    </StackPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0" Text="Elegir un problema para seleccionar la entidad y encuadrarla en el dibujo."
                         Visibility="{Binding HasItems, Converter={StaticResource Visible}}" />
            </StackPanel>
          </Expander>

          <!-- 3 · Estructuras -->
          <Expander Header="3 · Estructuras (muros)" DataContext="{Binding Walls}" Tag="{Binding CountText}">
            <StackPanel>
              <TextBlock Style="{StaticResource Value}" Margin="0,2,0,0" FontWeight="SemiBold" Text="{Binding CountText}" />
              <WrapPanel Margin="0,6,0,2">
                <TextBlock Style="{StaticResource FieldLabel}" Text="Mostrar" Margin="0,0,6,4" />
                <RadioButton GroupName="WallFilter" Content="_Todos" IsChecked="{Binding ShowAll}" Margin="0,0,12,4" />
                <RadioButton GroupName="WallFilter" Content="Sin _material" IsChecked="{Binding ShowMissing}" Margin="0,0,12,4" />
                <RadioButton GroupName="WallFilter" Content="_Seleccionados" IsChecked="{Binding ShowSelected}" Margin="0,0,12,4" />
              </WrapPanel>

              <Border BorderBrush="{DynamicResource Card.Border}" BorderThickness="1" Background="{DynamicResource Inset.Background}">
                <StackPanel>
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Focusable="False">
                  <StackPanel MinWidth="340">
                    <Grid Background="{DynamicResource Header.Background}">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="26" />
                        <ColumnDefinition Width="48" />
                        <ColumnDefinition Width="50" />
                        <ColumnDefinition Width="48" />
                        <ColumnDefinition Width="*" MinWidth="90" />
                        <ColumnDefinition Width="52" />
                        <ColumnDefinition Width="26" />
                      </Grid.ColumnDefinitions>
                      <Grid.Resources>
                        <Style TargetType="TextBlock">
                          <Setter Property="Foreground" Value="{DynamicResource Panel.Muted}" />
                          <Setter Property="FontWeight" Value="SemiBold" />
                          <Setter Property="Margin" Value="4,4,4,4" />
                          <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                        </Style>
                      </Grid.Resources>
                      <TextBlock Grid.Column="1" Text="Handle" />
                      <TextBlock Grid.Column="2" Text="Capa" />
                      <TextBlock Grid.Column="3" Text="Long." TextAlignment="Right" ToolTip="Longitud en metros" />
                      <TextBlock Grid.Column="4" Text="Material" />
                      <TextBlock Grid.Column="5" Text="Esp. (m)" ToolTip="Espesor en metros" />
                      <TextBlock Grid.Column="6" Text="AP" TextAlignment="Center" ToolTip="Muros que atraviesa el trayecto del AP al último punto consultado" />
                    </Grid>
                    <ItemsControl x:Name="WallRows" ItemsSource="{Binding VisibleRows}" MaxHeight="232" Focusable="False"
                                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel"
                                  Visibility="{Binding HasVisibleRows, Converter={StaticResource Visible}}">
                      <ItemsControl.Template>
                        <ControlTemplate TargetType="ItemsControl">
                          <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                            <ItemsPresenter />
                          </ScrollViewer>
                        </ControlTemplate>
                      </ItemsControl.Template>
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <VirtualizingStackPanel />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border x:Name="RowChrome" Background="Transparent" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Card.Border}" Height="29">
                            <Grid>
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="26" />
                                <ColumnDefinition Width="48" />
                                <ColumnDefinition Width="50" />
                                <ColumnDefinition Width="48" />
                                <ColumnDefinition Width="*" MinWidth="90" />
                                <ColumnDefinition Width="52" />
                                <ColumnDefinition Width="26" />
                              </Grid.ColumnDefinitions>
                              <Border x:Name="Marker" Grid.Column="0" Width="3" HorizontalAlignment="Left" Background="Transparent" />
                              <CheckBox Grid.Column="0" HorizontalAlignment="Center" IsChecked="{Binding IsSelected}"
                                        AutomationProperties.Name="{Binding Handle, StringFormat='Seleccionar muro {0}'}" />
                              <Button Grid.Column="1" Style="{StaticResource LinkButton}" Margin="4,0" VerticalAlignment="Center" Content="{Binding Handle}"
                                      Command="{Binding DataContext.ShowRowCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                      CommandParameter="{Binding}" ToolTip="Seleccionar y encuadrar este muro en el dibujo" />
                              <TextBlock Grid.Column="2" Margin="4,0" VerticalAlignment="Center" Text="{Binding Layer}" ToolTip="{Binding Layer}"
                                         TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Panel.Muted}" />
                              <TextBlock Grid.Column="3" Margin="4,0" VerticalAlignment="Center" Text="{Binding LengthText}" TextAlignment="Right" />
                              <ComboBox Grid.Column="4" Margin="2,2" ItemsSource="{Binding DataContext.Materials, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        SelectedItem="{Binding Material}" DisplayMemberPath="Name" Tag="{Binding MaterialPlaceholder}" ToolTip="{Binding MaterialNote}"
                                        AutomationProperties.Name="{Binding Handle, StringFormat='Material del muro {0}'}" />
                              <TextBox Grid.Column="5" Margin="2,2" Text="{Binding ThicknessText}"
                                       AutomationProperties.Name="{Binding Handle, StringFormat='Espesor del muro {0}'}" />
                              <Ellipse x:Name="PathDot" Grid.Column="6" Width="10" Height="10" Fill="{DynamicResource Path.Mark}" Visibility="Collapsed"
                                       ToolTip="{Binding PathNote}" />
                            </Grid>
                          </Border>
                          <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding MissingMaterial}" Value="True">
                              <Setter TargetName="Marker" Property="Background" Value="{DynamicResource Status.Error}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding UnknownMaterial}" Value="True">
                              <Setter TargetName="Marker" Property="Background" Value="{DynamicResource Status.Error}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsOnPath}" Value="True">
                              <Setter TargetName="RowChrome" Property="Background" Value="{DynamicResource Row.Path}" />
                              <Setter TargetName="PathDot" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsFocused}" Value="True">
                              <Setter TargetName="RowChrome" Property="Background" Value="{DynamicResource Row.Selected}" />
                            </DataTrigger>
                          </DataTemplate.Triggers>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </ScrollViewer>
                <TextBlock Style="{StaticResource EmptyState}" Margin="8,8,8,8" Text="{Binding EmptyText}"
                           Visibility="{Binding HasVisibleRows, Converter={StaticResource Hidden}}" />
                </StackPanel>
              </Border>

              <DockPanel Margin="0,6,0,0">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                  <Button Style="{StaticResource LinkButton}" Content="Marcar visibles" Command="{Binding SelectAllCommand}" Margin="8,0,0,0" VerticalAlignment="Center" />
                  <Button Style="{StaticResource LinkButton}" Content="Desmarcar" Command="{Binding ClearSelectionCommand}" Margin="10,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Style="{StaticResource Value}" Text="{Binding SelectionText}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
              </DockPanel>
              <WrapPanel Margin="0,4,0,0">
                <Button Content="Seleccionar en el _dibujo…" Command="{Binding PickInDrawingCommand}" Margin="0,4,6,0"
                        ToolTip="Elegir líneas o polilíneas en el dibujo. Las que todavía no son muros lo serán al asignarles material." />
                <Button Content="Ver selección" Command="{Binding ShowSelectionCommand}" IsEnabled="{Binding HasSelection}" Margin="0,4,0,0"
                        ToolTip="Selecciona en el dibujo los muros marcados y encuadra la vista." />
              </WrapPanel>

              <Border Style="{StaticResource Rule}" />
              <TextBlock Style="{StaticResource SubHeading}" Text="Asignar a los muros seleccionados" />
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Style="{StaticResource FieldLabel}" Text="Material" Margin="0,0,0,2" />
                <TextBlock Grid.Column="1" Style="{StaticResource FieldLabel}" Text="Espesor (m)" Margin="6,0,0,2" />
                <ComboBox Grid.Row="1" ItemsSource="{Binding Materials}" SelectedItem="{Binding BulkMaterial}" DisplayMemberPath="Name"
                          Tag="Elegir material…" AutomationProperties.Name="Material a asignar" />
                <TextBox Grid.Row="1" Grid.Column="1" Width="64" Margin="6,0,0,0" Text="{Binding BulkThicknessText, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Vacío conserva el espesor de cada muro (0,15 m si no tiene)." AutomationProperties.Name="Espesor a asignar en metros" />
                <Button Grid.Row="1" Grid.Column="2" Style="{StaticResource Primary}" Margin="6,0,0,0" Content="_Asignar" Command="{Binding AssignCommand}"
                        IsEnabled="{Binding HasSelection}" />
              </Grid>
              <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,0" Text="{Binding MaterialLossText}" />
            </StackPanel>
          </Expander>

          <!-- 4 · Punto de acceso -->
          <Expander Header="4 · Punto de acceso" DataContext="{Binding AccessPoint}">
            <StackPanel>
              <TextBlock Margin="0,2,0,6" TextWrapping="Wrap" Text="{Binding PositionSummary}">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding HasAccessPoint}" Value="False">
                        <Setter Property="Foreground" Value="{DynamicResource Status.Warning}" />
                        <Setter Property="FontStyle" Value="Italic" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
              <DockPanel>
                <Button DockPanel.Dock="Right" Content="_Ubicar en el dibujo…" Command="{Binding PickCommand}" Margin="8,0,0,0" />
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Style="{StaticResource FieldLabel}" Text="X (m)" />
                  <TextBox Grid.Column="1" Text="{Binding XText}" AutomationProperties.Name="Posición X del AP en metros" />
                  <TextBlock Grid.Column="2" Style="{StaticResource FieldLabel}" Text="Y (m)" Margin="8,0,6,0" />
                  <TextBox Grid.Column="3" Text="{Binding YText}" AutomationProperties.Name="Posición Y del AP en metros" />
                </Grid>
              </DockPanel>

              <Border Style="{StaticResource Rule}" />
              <DockPanel Margin="0,10,0,0">
                <TextBlock DockPanel.Dock="Left" Style="{StaticResource FieldLabel}" Text="Banda" />
                <ComboBox DockPanel.Dock="Left" Width="92" ItemsSource="{Binding Bands}" SelectedItem="{Binding SelectedBand}"
                          DisplayMemberPath="Label" AutomationProperties.Name="Banda" />
                <TextBlock VerticalAlignment="Center" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis">
                  <Run Text="Frecuencia " Foreground="{DynamicResource Panel.Muted}" />
                  <Run Text="{Binding FrequencyText, Mode=OneWay}" FontWeight="SemiBold" />
                </TextBlock>
              </DockPanel>
              <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="58" />
                  <ColumnDefinition Width="12" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="58" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="0" />
                  <RowDefinition Height="0" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="6" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="6" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="2" Style="{StaticResource FieldLabel}" Text="Potencia TX (dBm)" />
                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding TxPowerText}" AutomationProperties.Name="Potencia de transmisión en dBm" />
                <TextBlock Grid.Row="2" Grid.Column="3" Style="{StaticResource FieldLabel}" Text="Resolución (m)" />
                <TextBox Grid.Row="2" Grid.Column="4" Text="{Binding ResolutionText}" AutomationProperties.Name="Resolución de la grilla en metros"
                         ToolTip="Tamaño de celda de la grilla, entre 0,10 y 5 m." />

                <TextBlock Grid.Row="4" Style="{StaticResource FieldLabel}" Text="Antena TX (dBi)" />
                <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding TxGainText}" AutomationProperties.Name="Ganancia de antena de transmisión en dBi" />
                <TextBlock Grid.Row="4" Grid.Column="3" Style="{StaticResource FieldLabel}" Text="Antena RX (dBi)" />
                <TextBox Grid.Row="4" Grid.Column="4" Text="{Binding RxGainText}" AutomationProperties.Name="Ganancia de antena de recepción en dBi" />

                <TextBlock Grid.Row="6" Style="{StaticResource FieldLabel}" Text="Cable TX (dB)" />
                <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding TxCableText}" AutomationProperties.Name="Pérdida de cable de transmisión en dB" />
                <TextBlock Grid.Row="6" Grid.Column="3" Style="{StaticResource FieldLabel}" Text="Cable RX (dB)" />
                <TextBox Grid.Row="6" Grid.Column="4" Text="{Binding RxCableText}" AutomationProperties.Name="Pérdida de cable de recepción en dB" />
              </Grid>
              <TextBlock Style="{StaticResource Muted}" Margin="0,8,0,0"
                         Text="Los cambios se aplican con Enter o al salir del campo, y dejan el mapa desactualizado." />
            </StackPanel>
          </Expander>

          <!-- 5 · Calcular y mostrar -->
          <Expander Header="5 · Calcular y mostrar" DataContext="{Binding Calculation}" Tag="{Binding StateText}">
            <StackPanel>
              <TextBlock Style="{StaticResource FieldLabel}" Text="Área de cobertura" Margin="0,2,0,2" />
              <TextBlock Style="{StaticResource Value}" Text="{Binding AreaText}" />
              <WrapPanel>
                <Button Content="Elegir _polilínea…" Command="{Binding PickAreaCommand}" Margin="0,6,6,0"
                        ToolTip="Polilínea cerrada de tramos rectos. Fuera del área no se calcula ni se pinta." />
                <Button Content="Usar _rectángulo de los muros" Command="{Binding UseRectangleCommand}" IsEnabled="{Binding HasCustomArea}" Margin="0,6,0,0" />
              </WrapPanel>

              <Border Style="{StaticResource Rule}" />
              <DockPanel Margin="0,10,0,0">
                <Button DockPanel.Dock="Left" Style="{StaticResource Primary}" MinWidth="96" Content="_Calcular" Command="{Binding CalculateCommand}" />
                <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" FontWeight="SemiBold" Text="{Binding StateText}">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Setter Property="Foreground" Value="{DynamicResource Panel.Muted}" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding State}" Value="Current">
                          <Setter Property="Foreground" Value="{DynamicResource Status.Success}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding State}" Value="Outdated">
                          <Setter Property="Foreground" Value="{DynamicResource Status.Warning}" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
              </DockPanel>
              <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" FontStyle="Italic" Foreground="{DynamicResource Status.Warning}" Text="{Binding Readiness}"
                         Visibility="{Binding IsReady, Converter={StaticResource Hidden}}" />
              <ItemsControl Margin="0,4,0,0" ItemsSource="{Binding Problems}" Focusable="False"
                            Visibility="{Binding HasProblems, Converter={StaticResource Visible}}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Margin="0,2,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Status.Error}" Text="{Binding}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <Grid Margin="0,8,0,0" Visibility="{Binding HasSummary, Converter={StaticResource Visible}}">
                <Grid.Style>
                  <Style TargetType="Grid">
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsOutdated}" Value="True">
                        <Setter Property="Opacity" Value="0.55" />
                        <Setter Property="ToolTip" Value="Valores del cálculo anterior." />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Grid.Style>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Style="{StaticResource FieldLabel}" Text="Celdas" Margin="0,2,10,2" />
                <TextBlock Grid.Column="1" Style="{StaticResource Value}" Text="{Binding CellsText}" />
                <TextBlock Grid.Row="1" Style="{StaticResource FieldLabel}" Text="RSSI mínimo" Margin="0,2,10,2" />
                <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource Value}" Text="{Binding MinText}" />
                <TextBlock Grid.Row="2" Style="{StaticResource FieldLabel}" Text="RSSI máximo" Margin="0,2,10,2" />
                <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource Value}" Text="{Binding MaxText}" />
                <TextBlock Grid.Row="3" Style="{StaticResource FieldLabel}" Text="Tiempo" Margin="0,2,10,2" />
                <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource Value}" Text="{Binding TimeText}" />
              </Grid>

              <Border Style="{StaticResource Rule}" />
              <DockPanel Margin="0,10,0,0">
                <TextBlock DockPanel.Dock="Left" Style="{StaticResource FieldLabel}" Text="Atenuación del mapa" />
                <TextBlock DockPanel.Dock="Right" Width="38" TextAlignment="Right" VerticalAlignment="Center" Text="{Binding FadeText}" />
                <Slider Minimum="{Binding MinFade, Mode=OneTime}" Maximum="{Binding MaxFade, Mode=OneTime}" SmallChange="5" LargeChange="10"
                        TickFrequency="5" IsSnapToTickEnabled="True" VerticalAlignment="Center" Value="{Binding FadePercent, Delay=250}"
                        AutomationProperties.Name="Atenuación del mapa en porcentaje"
                        ToolTip="0 % = colores plenos. Se aplica al mapa ya dibujado, sin recalcular." />
              </DockPanel>

              <TextBlock Style="{StaticResource SubHeading}" Text="Leyenda: RSSI estimado" />
              <ItemsControl ItemsSource="{Binding Legend}" Focusable="False">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <UniformGrid Columns="2" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Orientation="Horizontal" Margin="0,2,6,2" ToolTip="{Binding ColorName}">
                      <Border Width="22" Height="14" CornerRadius="2" Background="{Binding ColorHex}" BorderBrush="{DynamicResource Swatch.Border}" BorderThickness="1" />
                      <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" Text="{Binding Label}" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Expander>

          <!-- 6 · Consultar punto -->
          <Expander Header="6 · Consultar punto" DataContext="{Binding Query}">
            <StackPanel>
              <DockPanel Margin="0,2,0,0">
                <Button DockPanel.Dock="Left" Content="C_onsultar punto…" Command="{Binding QueryCommand}"
                        ToolTip="Cada clic en el dibujo actualiza la tarjeta. Esc o Enter termina." />
                <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Limpiar" Command="{Binding ClearCommand}" VerticalAlignment="Center"
                        Visibility="{Binding HasResult, Converter={StaticResource Visible}}" />
                <TextBlock />
              </DockPanel>
              <TextBlock Style="{StaticResource EmptyState}" Text="{Binding EmptyText}" Visibility="{Binding HasResult, Converter={StaticResource Hidden}}" />

              <Border Margin="0,8,0,0" Padding="10,8" CornerRadius="4" Background="{DynamicResource Inset.Background}"
                      BorderBrush="{DynamicResource Card.Border}" BorderThickness="1" Visibility="{Binding HasResult, Converter={StaticResource Visible}}">
                <StackPanel>
                  <DockPanel>
                    <Border DockPanel.Dock="Left" Width="14" CornerRadius="2" Margin="0,2,8,2" Background="{Binding LevelColorHex}"
                            BorderBrush="{DynamicResource Swatch.Border}" BorderThickness="1" />
                    <StackPanel>
                      <TextBlock FontSize="18" FontWeight="SemiBold" Text="{Binding ReceivedText}" />
                      <TextBlock Style="{StaticResource Muted}" Text="{Binding LevelText}" />
                    </StackPanel>
                  </DockPanel>
                  <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Punto" Margin="0,2,10,2" />
                    <TextBlock Grid.Column="1" Style="{StaticResource Value}" Text="{Binding PointText}" />
                    <TextBlock Grid.Row="1" Style="{StaticResource FieldLabel}" Text="Distancia al AP" Margin="0,2,10,2" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource Value}" Text="{Binding DistanceText}" />
                    <TextBlock Grid.Row="2" Style="{StaticResource FieldLabel}" Text="L₀ (espacio libre)" Margin="0,2,10,2" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource Value}" Text="{Binding PathLossText}" />
                    <TextBlock Grid.Row="3" Style="{StaticResource FieldLabel}" Text="L materiales" Margin="0,2,10,2" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource Value}" Text="{Binding WallLossText}" />
                    <TextBlock Grid.Row="4" Style="{StaticResource FieldLabel}" Text="P_RX (RSSI estimado)" Margin="0,2,10,2" />
                    <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource Value}" FontWeight="SemiBold" Text="{Binding ReceivedText}" />
                  </Grid>

                  <DockPanel Margin="0,8,0,0">
                    <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Ver en el dibujo" Command="{Binding ShowWallsCommand}"
                            Visibility="{Binding HasCrossings, Converter={StaticResource Visible}}" />
                    <TextBlock FontWeight="SemiBold" Text="{Binding CrossingsTitle}" />
                  </DockPanel>
                  <ItemsControl ItemsSource="{Binding Crossings}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <StackPanel Margin="0,3,0,0">
                          <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding LossText}" FontWeight="SemiBold" Margin="8,0,0,0" />
                            <TextBlock TextTrimming="CharacterEllipsis">
                              <Run Text="{Binding Handle, Mode=OneWay}" Foreground="{DynamicResource Path.Mark}" FontWeight="SemiBold" />
                              <Run Text=" · " />
                              <Run Text="{Binding Material, Mode=OneWay}" />
                            </TextBlock>
                          </DockPanel>
                          <TextBlock Style="{StaticResource Muted}" Text="{Binding JunctionNote}"
                                     Visibility="{Binding HasJunction, Converter={StaticResource Visible}}" />
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <Expander x:Name="FullExplanation" Header="Explicación completa" IsExpanded="False" Margin="0,8,0,0">
                    <TextBox IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" BorderThickness="0" Padding="0" FontSize="11.5"
                             Text="{Binding Explanation, Mode=OneWay}" AutomationProperties.Name="Explicación completa de la consulta" />
                  </Expander>
                </StackPanel>
              </Border>
            </StackPanel>
          </Expander>

          <!-- 7 · Exportar PNG -->
          <Expander Header="7 · Exportar PNG" DataContext="{Binding Export}">
            <StackPanel>
              <Button Margin="0,2,0,0" HorizontalAlignment="Left" Content="_Exportar PNG…" Command="{Binding ExportCommand}"
                      ToolTip="Guarda el mapa del último cálculo con muros, AP y leyenda." />
              <TextBlock Style="{StaticResource EmptyState}" Text="{Binding EmptyText}" Visibility="{Binding HasPath, Converter={StaticResource Hidden}}" />
              <StackPanel Visibility="{Binding HasPath, Converter={StaticResource Visible}}">
                <TextBlock Style="{StaticResource FieldLabel}" Text="Último archivo exportado" Margin="0,8,0,2" />
                <TextBox IsReadOnly="True" TextWrapping="Wrap" Text="{Binding LastPath, Mode=OneWay}" AutomationProperties.Name="Ruta del último archivo exportado" />
              </StackPanel>
            </StackPanel>
          </Expander>
        </StackPanel>
      </ScrollViewer>

      <!-- Esperando al usuario u ocupado -->
      <Border Grid.Row="2" Background="{DynamicResource Banner.Background}" Padding="10,6"
              Visibility="{Binding IsInteracting, Converter={StaticResource Visible}}">
        <TextBlock TextWrapping="Wrap" Text="{Binding ActiveMode.Instruction}" />
      </Border>
      <Border Grid.Row="2" Background="{DynamicResource Banner.Background}" Padding="10,6"
              Visibility="{Binding IsBusy, Converter={StaticResource Visible}}">
        <DockPanel>
          <ProgressBar DockPanel.Dock="Right" Width="70" Height="8" IsIndeterminate="True" VerticalAlignment="Center" Margin="8,0,0,0" />
          <TextBlock TextWrapping="Wrap" FontWeight="SemiBold" Text="{Binding BusyText}" />
        </DockPanel>
      </Border>

      <!-- Estado -->
      <Border Grid.Row="3" Background="{DynamicResource Header.Background}" Padding="10,6" MinHeight="30">
        <DockPanel>
          <Ellipse DockPanel.Dock="Left" Width="9" Height="9" Margin="0,3,8,0" VerticalAlignment="Top">
            <Ellipse.Style>
              <Style TargetType="Ellipse">
                <Setter Property="Fill" Value="{DynamicResource Status.Info}" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Messages.Kind}" Value="Error">
                    <Setter Property="Fill" Value="{DynamicResource Status.Error}" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding Messages.Kind}" Value="Warning">
                    <Setter Property="Fill" Value="{DynamicResource Status.Warning}" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding Messages.Kind}" Value="Success">
                    <Setter Property="Fill" Value="{DynamicResource Status.Success}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Ellipse.Style>
          </Ellipse>
          <TextBlock x:Name="StatusText" TextWrapping="Wrap" MaxHeight="78" TextTrimming="CharacterEllipsis"
                     ToolTip="{Binding Messages.Text}" AutomationProperties.LiveSetting="Polite">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Text" Value="{Binding Messages.Text}" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Messages.Text}" Value="">
                    <Setter Property="Text" Value="Listo." />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </DockPanel>
      </Border>
    </Grid>
  </Grid>
</UserControl>
